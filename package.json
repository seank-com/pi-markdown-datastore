{
  "name": "@seank/pi-markdown-datastore",
  "version": "0.1.0",
  "description": "Read-only Markdown stores with optional qmd search",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "repository": {"type": "git", "url": "https://github.com/seank-com/pi-markdown-datastore.git"},
  "files": ["dist", "README.md", "LICENSE", "docs"],
  "pi": {"extensions": ["./dist/index.js"]},
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./contract": {"types": "./dist/contract.d.ts", "import": "./dist/contract.js"},
    "./client": {"types": "./dist/client.d.ts", "import": "./dist/client.js"}
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.ts",
    "build": "node scripts/clean-build.ts && tsc -p tsconfig.json && node scripts/copy-assets.ts",
    "test:package": "npm run build && node --test tests/package.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {"mdast-util-from-markdown": "2.0.3", "yaml": "2.9.1"},
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.3.1",
    "typebox": "1.3.27",
    "typescript": "5.9.2"
  },
  "engines": {"node": ">=24.14.1"}
}
